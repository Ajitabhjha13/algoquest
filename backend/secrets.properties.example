# Copy this file to "secrets.properties" (same folder as pom.xml) and fill real values.
# secrets.properties is listed in .gitignore and must NEVER be committed or shared.

# ---------- Database: TiDB Cloud (Singapore) ----------
DB_URL=jdbc:mysql://gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/algoquest?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3
DB_USER=YOUR_TIDB_USERNAME
DB_PASSWORD=YOUR_TIDB_PASSWORD

# ---------- Login with GitHub ----------
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

# ---------- Login with Google ----------
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-YOUR_GOOGLE_CLIENT_SECRET

# ---------- JWT (base64 of 48 random bytes) ----------
JWT_SECRET=YOUR_BASE64_SECRET

# ---------- Alert emails: Resend API key ("Sending access" only) ----------
RESEND_API_KEY=re_YOUR_RESEND_API_KEY